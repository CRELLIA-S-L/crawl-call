#!/bin/sh
# SRS-DD-0.24.0 pre-commit gate.
# Template copied into target projects as .githooks/pre-commit by
# tools/srs_init.py. One-time activation in the target repository:
#     git config core.hooksPath .githooks
#
# Do that only if nothing else owns pre-commit — the setting redirects
# every hook, so an existing one would stop running. Where a project
# already has its own, call this file from it instead:
#     sh .githooks/pre-commit || exit 1
# It cds to the repository root itself, so it works from anywhere.
#
# The gate itself is srs-dd/tools/srs_gate.py, refreshed with the rest of the
# tooling on every upgrade, so this file has nothing to change when the
# gate does. --staged adds the grounds register's report on what the
# commit touches; add --strict to also fail on warnings.
set -e
cd "$(git rev-parse --show-toplevel)"
# The references between the parts are the project's own generated file: it is produced
# from the code rather than kept, and a commit that leaves it stale is refused here
# (FR-TOOL-330, FR-TOOL-340).
#
# file implements: FR-TOOL-340
python3 scripts/arch-edges.py --check || exit 1

exec python3 srs-dd/tools/srs_gate.py --staged
